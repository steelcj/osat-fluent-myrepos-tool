#!/usr/bin/env bash
# ~/.local/bin/{command}
# Generated by {manager}. Do not edit; regenerated on --install and --switch.
# Sources {env_file} at runtime and exports MYREPOS_TOOL_ROOT so mrconfig
# actions and lib includes can reference a version-stable path.
. "$HOME/.config/myrepos-tool/myrepos-tool.env"
export MYREPOS_TOOL_ROOT
exec "$MYREPOS_TOOL_ROOT/{relpath}" "$@"
